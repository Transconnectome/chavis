+@pytest.mark.parametrize("malformation", ["missing_messages", "wrong_thread", "wrong_account", "duplicate_message", "wrong_child_thread"])
+def test_malformed_full_thread_cannot_erase_old_sources_or_renew_snapshot(store, malformation):
+    from tools.cha_philosophy.connectors import ConnectorError
+    from tools.cha_philosophy.sync import sync_gmail
+    from tools.cha_philosophy.tests.test_sync import CONFIG, GmailFixture, thread
+    good = GmailFixture({"": {"threads": [{"id": "a"}]}})
+    sync_gmail(store, CONFIG, good, 1)
+    source = next(store.sources(platform="gmail"))
+    before = store.extraction_context(source)
+    class Bad(GmailFixture):
+        def get_gmail_thread(self, tid):
+            raw = thread(tid)
+            if malformation == "missing_messages": del raw["thread"]["messages"]
+            if malformation == "wrong_thread": raw["thread"]["id"] = "another"
+            if malformation == "wrong_account": raw["_account_id"] = "another@example.invalid"
+            if malformation == "duplicate_message": raw["thread"]["messages"] *= 2
+            if malformation == "wrong_child_thread": raw["thread"]["messages"][0]["threadId"] = "another"
+            return raw
+    with pytest.raises(ConnectorError, match="gmail_thread_shape"):
+        sync_gmail(store, CONFIG, Bad(good.pages), 1)
+    assert store.get_source(source["source_id"]) == source
+    assert store.extraction_context(source) == before
