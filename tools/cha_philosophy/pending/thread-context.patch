new file mode 100644
--- /dev/null
+++ b/tools/cha_philosophy/tests/test_editorial_capability_redaction.py
@@ -0,0 +1,35 @@
+"""A personally addressed editorial access URL never becomes model text."""
+from copy import deepcopy
+
+import pytest
+
+from tools.cha_philosophy.connectors import sanitize_source
+
+
+@pytest.mark.parametrize('url', [
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?el=syntheticAuthorAccess',
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?form=home&el=syntheticAuthorAccess',
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?form=home&amp;el=syntheticAuthorAccess',
+    'HTTPS://MTS-NCOMMS.NATURE.COM:443/cgi-bin/main.plex?EL=syntheticAuthorAccess',
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?el=syntheticAuthorAccess&el=secondSyntheticAccess',
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?el=syntheticAuthorAccess&next=home'])
+def test_observed_personal_access_link_is_redacted_in_all_stored_text_fields(url):
+    raw={'body':'Author access: '+url+'\nKeep the evidence limits.',
+         'authored_text':url,'metadata':{'forwarded_message':url}}
+    before=deepcopy(raw);result=sanitize_source(raw)
+    assert 'syntheticAuthorAccess' not in str(result)
+    assert result['authored_text']=='[REDACTED_SECRET]'
+    assert result['body'].endswith('Keep the evidence limits.')
+    assert result['metadata']['forwarded_message']=='[REDACTED_SECRET]'
+    assert sanitize_source(result)==result
+    assert raw==before
+
+
+@pytest.mark.parametrize('url', [
+    'https://example.invalid/article?el=element',
+    'https://mts-ncomms.nature.com.example.invalid/?el=element',
+    'https://mts-ncomms.nature.com/cgi-bin/main.plex?form=public',
+    'https://www.nature.com/articles/synthetic?el=element'])
+def test_host_specific_key_does_not_remove_unrelated_scientific_links(url):
+    raw={'body':url,'authored_text':url,'metadata':{}}
+    assert sanitize_source(raw)==raw
