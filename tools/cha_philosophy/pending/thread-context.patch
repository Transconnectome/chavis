+"""Synthetic conversation dependency, withdrawal, and snapshot transaction tests."""
+from copy import deepcopy
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+
+import pytest
+
+from tools.cha_philosophy.store import ExtractionContextError, SourceExcludedError, Store
+
+
+ACCOUNT = "professor@example.invalid"
+
+
+def message(mid="original", *, thread="thread", account=ACCOUNT, text=None, **changes):
+    text = text or "Evaluate every claim against the available research evidence."
+    return {"source_id": f"gmail/{account}/{thread}//{mid}", "platform": "gmail", "scope": "test-lab",
+            "author_id": account, "authorship": "direct", "status": "active", "body": text,
+            "authored_text": text, "created_at": "2026-09-01T00:00:00+00:00",
+            "metadata": {"account_id": account, "thread_id": thread}, **changes}
+
+
+@pytest.fixture
+def store(tmp_path):
+    value = Store(tmp_path / "private")
+    yield value
+    value.close()
+
+
+def publish(store, *rows):
+    first = rows[0]
+    store.reconcile_gmail_thread(first["metadata"]["account_id"], first["metadata"]["thread_id"], rows)
+    return store.get_source(first["source_id"])
+
+
+def candidate(source):
+    return {"statement": "Scope interpretation to the evidence.", "domains": ["review"],
+            "evidence": [{"source_id": source["source_id"], "source_hash": source["source_hash"],
+                          "quote": source["authored_text"]}]}
+
+
+def activate(store, source):
+    pid = store.add_principle(candidate(source))
+    context = store.extraction_context(source)
+    store.review(pid, "evidence_supported", "synthetic reviewer", "Entire synthetic thread reviewed.",
+                 thread_context_revisions={context["family"]: context["revision"]})
+    return pid
+
+
+def result(store, source, principles=None):
+    text = source["authored_text"]
+    return {"status": "complete", "source_id": source["source_id"], "source_hash": source["source_hash"],
+            "authored_chars": len(text), "chunks_total": 1, "chunks_processed": 1,
+            "inference_calls": 1, "extractor_id": "a" * 64, "principles": principles or [],
+            "thread_context_binding": store.context_binding(store.extraction_context(source)),
+            "chunk_results": [{"index": 0, "start": 0, "end": len(text),
+                               "text_hash": hashlib.sha256(text.encode()).hexdigest()}]}
+
+
+def test_gmail_requires_full_thread_snapshot_even_when_original_is_fresh(store):
+    raw = message()
+    store.upsert(raw, verified_remote=True)
+    source = store.get_source(raw["source_id"])
+    with pytest.raises(ExtractionContextError, match="context_unavailable"):
+        store.extraction_context(source)
+    raw["metadata"] = {}
+    store.upsert(raw, verified_remote=True)
+    with pytest.raises(ExtractionContextError, match="context_unavailable"):
+        store.extraction_context(store.get_source(raw["source_id"]))
+
+
+def test_non_gmail_has_no_thread_context(store):
+    source = message(platform="drive")
+    store.upsert(source)
+    assert store.extraction_context(store.get_source(source["source_id"])) is None
+
+
+def test_new_correction_stales_rule_and_requeues_empty_decision_without_original_edit(store):
+    original = message()
+    source = publish(store, original)
+    pid = activate(store, source)
+    old = result(store, source)
+    store.commit_extraction(source, old)
+    assert list(store.pending_extraction(extractor_id="a" * 64)) == []
+    later = message("later", text="Apply only the relevant suggestion; retain the original analysis.",
