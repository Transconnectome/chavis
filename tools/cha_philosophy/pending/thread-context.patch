@@ -0,0 +1,62 @@
+"""Explicit current-thread review is required and the reader preserves inputs."""
+import json
+
+from tools.cha_philosophy.cli import main
+from tools.cha_philosophy.store import Store
+from tools.cha_philosophy.tests.test_thread_extraction import ACCOUNT, THREAD, message
+
+
+def setup_store(tmp_path):
+    home=tmp_path/'private';store=Store(home)
+    row=message('a','결론의 강도는 실제 자료가 뒷받침하는 수준에 맞추어 작성합니다.')
+    store.reconcile_gmail_thread(ACCOUNT,THREAD,[row])
+    src=store.get_source(row['source_id'])
+    pid=store.add_principle({'statement':'근거의 범위에 맞추어 결론의 강도를 조정한다.',
+        'domains':['review'],'evidence':[{'source_id':src['source_id'],'source_hash':src['source_hash'],
+                                       'quote':src['authored_text']}],
+        'exceptions':[],'rationale':'Synthetic scoped interpretation.'})
+    snapshot=store.extraction_context(src);store.close()
+    return home,src,pid,snapshot
+
+
+def test_thread_reader_emits_complete_current_snapshot_to_private_new_file(tmp_path,capsys):
+    home,src,_,snapshot=setup_store(tmp_path);output=tmp_path/'thread.json'
+    args=['--home',str(home),'thread',src['source_id'],'--output',str(output)]
+    assert main(args)==0
+    saved=json.loads(output.read_text())
+    assert saved==snapshot
+    assert saved['members'][0]['body']==src['body']
+    assert output.stat().st_mode & 0o777==0o600
+    before=output.read_bytes()
+    assert main(args)==1
+    assert output.read_bytes()==before
+    assert src['body'] not in capsys.readouterr().out
+
+
+def test_review_requires_explicit_current_thread_and_old_mapping_cannot_reactivate(tmp_path,capsys):
+    home,src,pid,snapshot=setup_store(tmp_path)
+    args=['--home',str(home),'review',pid,'evidence_supported','--reviewer','synthetic','--reason','Reviewed current synthetic thread.']
+    assert main(args)==1
+    revisions=tmp_path/'revisions.json'
+    revisions.write_text(json.dumps({snapshot['family']:snapshot['revision']}))
+    assert main([*args,'--thread-context-revisions',str(revisions)])==0
+    store=Store(home)
+    p=store.get_principle(pid)
+    assert p['status']=='evidence_supported'
+    assert p['thread_context_bindings']==[store.context_binding(snapshot)]
+    store.reconcile_gmail_thread(ACCOUNT,THREAD,[message('a',src['authored_text']),
+        message('b','위 판단의 적용은 이번 과제와 주어진 자료의 범위로 한정합니다.')])
+    assert store.get_principle(pid)['status']=='stale'
+    store.close()
+    assert main([*args,'--thread-context-revisions',str(revisions)])==1
+    store=Store(home);assert store.get_principle(pid)['status']=='stale';store.close()
+    assert src['authored_text'] not in capsys.readouterr().out
+
+
+def test_thread_read_requires_verified_snapshot_and_has_safe_error(tmp_path,capsys):
+    home=tmp_path/'private';store=Store(home);row=message('a','이 결론은 실제 검토한 근거의 강도에 맞추어 수정합니다.')
+    store.upsert(row);store.close()
+    assert main(['--home',str(home),'thread',row['source_id']])==1
+    result=json.loads(capsys.readouterr().out)
+    assert result['error_code']=='context_unavailable'
+    assert row['body'] not in json.dumps(result,ensure_ascii=False)
