+"""Thread corrections reach inference; revisions constrain candidate commits."""
+import json
+from unittest.mock import Mock
+
+import pytest
+
+from tools.cha_philosophy import distill, runner
+from tools.cha_philosophy.connectors import source_key
+from tools.cha_philosophy.store import Store, source_hash
+
+
+ACCOUNT = "prof@example.invalid"
+THREAD = "synthetic-thread"
+
+
+def message(mid, text, *, direct=True, body=None, when="2026-09-01T00:00:00+00:00"):
+    row = {"source_id": source_key("gmail", ACCOUNT, THREAD, "", mid),
+           "platform": "gmail", "scope": "connectome_lab_correspondence",
+           "author_id": ACCOUNT if direct else "student@example.invalid",
+           "authorship": "direct" if direct else "context", "status": "active",
+           "body": text if body is None else body, "authored_text": text if direct else "",
+           "created_at": when,
+           "metadata": {"account_id": ACCOUNT, "thread_id": THREAD,
+                        "authorship_basis": "sent_verified_from_exact_lab_recipient" if direct else "thread_context"}}
+    row["source_hash"] = source_hash(row)
+    return row
+
+
+def empty_answer(messages, schema):
+    return {"outcome": "no_principles", "rationale": "Synthetic scoped empty decision.", "principles": []}
+
+
+@pytest.fixture
+def store(tmp_path):
+    value = Store(tmp_path / "private")
+    yield value
+    value.close()
+
+
+def reconcile(store, rows):
+    store.reconcile_gmail_thread(ACCOUNT, THREAD, rows)
+    return store.get_source(rows[0]["source_id"])
+
+
+def test_later_qualification_and_footer_reach_every_primary_chunk(store):
+    own = "이 초안의 판단 기준을 근거와 예외를 포함해서 검토하세요.\n" * 30
+    late = "앞선 초안을 전부 적용하지 말고 타당한 항목만 선택하세요. 분석은 유지합니다."
+    rows = [message("a", own), message("b", late, body=late + "\n--\nChavis 올림 (Claude Code 대필)",
+                                       when="2026-09-04T00:00:00+00:00")]
+    src = reconcile(store, rows); snapshot = store.extraction_context(src)
+    client = Mock(model=distill.DEFAULT_MODEL); client.complete.side_effect = empty_answer
+    result = distill.extract(src, client, max_chunk_bytes=512, thread_context=snapshot)
+    chunks = []
+    for call in client.complete.call_args_list:
+        messages = call.args[0]; data = json.loads(messages[-1]["content"])
+        chunks.append(data["authored_text"])
+        ctx = data["thread_context"]
+        assert ctx["primary_source_in_context"] is False
+        assert ctx["full_thread_supplied"] is False
+        assert ctx["all_eligible_other_direct_messages_supplied"] is True
+        assert len(ctx["messages"]) == 1
+        assert ctx["messages"][0]["authored_text"] == late
+        assert ctx["messages"][0]["attribution_context"]["spans"][0]["text"] == "Chavis 올림 (Claude Code 대필)"
+        assert data["attribution_context"]["thread_context_supplied"] is True
+    assert len(chunks) > 1 and "".join(chunks) == own
+    assert result["thread_context_binding"] == store.context_binding(snapshot)
+    assert late not in json.dumps(result["thread_context_summary"], ensure_ascii=False)
+
+
+def test_other_participants_and_explicitly_excluded_messages_are_counted_not_supplied(store):
+    rows = [message("a", "현재 판단은 확인한 자료와 한계에 맞추어 작성합니다."),
+            message("b", "PRIVATE_STUDENT_MESSAGE", direct=False),
+            message("c", "EXCLUDED_EXTERNAL_TEXT")]
+    src = reconcile(store, rows)
+    excluded = store.get_source(rows[2]["source_id"])
+    store.review_source_exclusion(excluded["source_id"], source_hash=excluded["source_hash"],
+                                  exclude=True, reviewer="synthetic", reason="External synthetic material")
+    snapshot = store.extraction_context(src)
+    client = Mock(model=distill.DEFAULT_MODEL); client.complete.side_effect = empty_answer
+    distill.extract(src, client, thread_context=snapshot)
+    data = json.loads(client.complete.call_args.args[0][-1]["content"])
+    assert data["thread_context"]["non_direct_messages_omitted"] == 1
+    assert data["thread_context"]["excluded_messages_omitted"] == 1
+    assert "PRIVATE_STUDENT_MESSAGE" not in json.dumps(data)
+    assert "EXCLUDED_EXTERNAL_TEXT" not in json.dumps(data)
+
+
+@pytest.mark.parametrize('primary_at, expected', [
+    ('2026-09-02T00:00:00+00:00', ['before', 'after']),
+    ('2026-09-04T00:00:00+00:00', ['before', 'before']),
+    ('2026-09-03T09:00:00+09:00', ['before', 'same_timestamp']),
+    ('2026-09-02T00:00:00', ['unknown', 'unknown']),
+    ('unverified-date', ['unknown', 'unknown'])])
+def test_primary_time_distinguishes_earlier_and_later_instructions(store, primary_at, expected):
+    rows = [message('primary', '현재 검토할 지침은 이 메시지의 구체적 조건을 따릅니다.', when=primary_at),
+            message('earlier', '처음 지침은 충분한 근거를 갖추고 결론을 검토하라는 것입니다.', when='2026-09-01T00:00:00+00:00'),
+            message('later', '해당 조건을 수정하며 이 후속 지침의 범위를 유지하세요.', when='2026-09-03T00:00:00+00:00')]
+    src = reconcile(store, rows)
+    context = distill.source_thread_context(src, store.extraction_context(src))
+    assert context['primary_created_at'] == primary_at
+    assert [m['relative_to_primary'] for m in context['messages']] == expected
+
+
+def test_context_quote_cannot_substitute_for_primary_evidence(store):
+    rows = [message("a", "이 결과를 현재 자료의 한계 안에서 해석하세요."),
+            message("b", "나중 지침의 특별한 문장은 현재 원문의 인용 근거가 아닙니다.")]
+    src = reconcile(store, rows)
+    client = Mock(model=distill.DEFAULT_MODEL)
+    client.complete.return_value = {"outcome": "principles", "rationale": "Synthetic decision.",
+        "principles": [{"statement": "자료의 한계에 맞추어 해석한다.", "domains": ["review"],
+                        "evidence": [{"quote": rows[1]["authored_text"]}], "exceptions": [],
+                        "rationale": "Synthetic quotation boundary."}]}
+    with pytest.raises(distill.ExtractionError) as error:
+        distill.extract(src, client, thread_context=store.extraction_context(src), max_chunk_attempts=1)
+    assert error.value.code == "quote_mismatch"
+
+
+def test_thread_overflow_never_drops_later_message_or_calls_model(store):
+    rows = [message("a", "현재 원고의 판단 기준을 근거에 맞게 수정하세요."),
+            message("b", "긴 선행 지침. " * 1000),
+            message("c", "앞선 긴 지침은 철회하며 현재 자료에 한정해서 판단하세요.")]
+    src = reconcile(store, rows); client = Mock(model=distill.DEFAULT_MODEL)
+    with pytest.raises(distill.ExtractionError) as error:
+        distill.extract(src, client, thread_context=store.extraction_context(src))
+    assert error.value.code == "context_budget"
+    assert error.value.retryable is False and error.value.inference_calls == 0
+    client.complete.assert_not_called()
+
+
+def test_runner_missing_full_thread_snapshot_cannot_call_model(store, monkeypatch):
+    row = message("a", "근거의 범위에 맞추어 결론의 강도를 결정합니다.")
+    store.upsert(row)
+    client = Mock(model=distill.DEFAULT_MODEL)
+    monkeypatch.setattr(runner, "LocalOllamaClient", lambda **_: client)
+    result = runner.distill_pending(store, limit=1)
+    assert result["results"][0]["error_code"] == "context_unavailable"
+    assert result["results"][0]["inference_calls"] == 0
+    client.complete.assert_not_called()
+
+
+def test_context_change_during_inference_refuses_empty_completion_and_resets_retry(store, monkeypatch):
+    rows = [message("a", "이 원고는 근거와 반론을 모두 검토해야 합니다.")]
+    src = reconcile(store, rows); client = Mock(model=distill.DEFAULT_MODEL)
+    def changed(messages, schema):
+        reconcile(store, [*rows, message("b", "이 지침의 적용 범위는 이번 과제에 한정합니다.")])
+        return empty_answer(messages, schema)
+    client.complete.side_effect = changed
+    monkeypatch.setattr(runner, "LocalOllamaClient", lambda **_: client)
+    result = runner.distill_pending(store, limit=1)
+    assert result["results"][0]["error_code"] == "context_changed"
+    assert store.extraction_record(src)["status"] == "failed"
+    client.complete.side_effect = empty_answer
+    result = runner.distill_pending(store, limit=2)
+    assert any(r["source_id"] == src["source_id"] and r["state"] == "complete" for r in result["results"])
+
+
+def test_later_reply_requeues_previous_no_principles_for_same_source_revision(store, monkeypatch):
+    rows = [message("a", "이 원고의 판단 기준을 자료와 함께 검토하세요.")]
+    src = reconcile(store, rows); client = Mock(model=distill.DEFAULT_MODEL)
+    client.complete.side_effect = empty_answer
+    monkeypatch.setattr(runner, "LocalOllamaClient", lambda **_: client)
+    assert runner.distill_pending(store, limit=1)["results"][0]["state"] == "complete"
+    reconcile(store, [*rows, message("b", "앞선 판단 기준은 반론을 충분히 반영하지 못했습니다.")])
+    current = store.get_source(src["source_id"])
+    assert current["source_hash"] == src["source_hash"]
+    assert src["source_id"] in {s["source_id"] for s in store.pending_extraction(extractor_id=distill.extractor_fingerprint())}
+
+
+def test_context_changed_by_earlier_batch_item_cannot_consume_old_retry_budget(store, monkeypatch):
+    rows = [message('a', '먼저 검토할 문장은 확인한 근거의 범위를 유지해야 합니다.'),
+            message('b', '뒤에 검토할 문장은 그 근거와 한계를 구체적으로 설명합니다.')]
+    reconcile(store, rows)
+    second = store.get_source(rows[1]['source_id'])
+    old_revision = store.extraction_context(second)['revision']
+    store.mark_extraction(second, 'failed', attempts=2, retryable=True,
+                          extractor_id=distill.extractor_fingerprint(), context_revision=old_revision,
+                          next_retry_at='2020-01-01T00:00:00+00:00')
+    client = Mock(model=distill.DEFAULT_MODEL)
+    def response(messages, schema):
+        data = json.loads(messages[-1]['content'])
+        if data['source_id'] == rows[0]['source_id']:
+            reconcile(store, [*rows, message('c', '이 지침들은 현재 과제의 자료 범위로 한정합니다.')])
+            return empty_answer(messages, schema)
+        return 'invalid-json'
+    client.complete.side_effect = response
+    monkeypatch.setattr(runner, 'LocalOllamaClient', lambda **_: client)
+    result = runner.distill_pending(store, limit=2)
+    failure = next(r for r in result['results'] if r['source_id'] == second['source_id'])
+    current_revision = store.extraction_context(second)['revision']
+    assert current_revision != old_revision
+    assert failure['error_code'] == 'response_json'
+    assert failure['context_revision'] == current_revision
+    assert failure['attempts'] == 1 and failure['held'] is False
