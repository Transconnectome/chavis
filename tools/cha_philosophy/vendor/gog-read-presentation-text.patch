+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"google.golang.org/api/option"
+	"google.golang.org/api/slides/v1"
+
+	"github.com/steipete/gogcli/internal/outfmt"
+)
+
+type slidesTextRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f slidesTextRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+// All requests stay in memory. Replacing the entire service factory and using
+// an explicit account avoids the real OAuth, ADC, keyring and HTTP paths.
+func slidesTextMock(t *testing.T, bodies []string, status int) *int {
+	t.Helper()
+	calls, factories := 0, 0
+	client := &http.Client{Transport: slidesTextRoundTripper(func(r *http.Request) (*http.Response, error) {
+		if r.Method != http.MethodGet || r.URL.Host != "slides.googleapis.com" || r.URL.Path != "/v1/presentations/pres1" {
+			t.Fatalf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		if r.Header.Get("Authorization") != "" {
+			t.Fatal("unexpected authorization header")
+		}
+		if _, ok := r.Context().Deadline(); !ok {
+			t.Fatal("missing read deadline")
+		}
+		fields := r.URL.Query().Get("fields")
+		if calls == 0 {
+			if fields != string(slidesTextPresentationFields()) {
+				t.Fatalf("unexpected textual fields: %s", fields)
+			}
+			for _, forbidden := range []string{"image", "contentUrl", "thumbnail", "sheetsChart", "layout", "master", "link", "*"} {
+				if strings.Contains(fields, forbidden) {
+					t.Fatalf("unbounded field: %s", forbidden)
+				}
+			}
+		} else if fields != "presentationId,revisionId,slides(objectId)" {
+			t.Fatalf("unexpected final fields: %s", fields)
+		}
+		if calls >= len(bodies) {
+			t.Fatal("too many requests")
+		}
+		body := bodies[calls]
+		calls++
+		return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	})}
+	svc, err := slides.NewService(context.Background(), option.WithoutAuthentication(), option.WithHTTPClient(client))
+	if err != nil {
+		t.Fatal(err)
+	}
+	orig := newSlidesService
+	newSlidesService = func(_ context.Context, account string) (*slides.Service, error) {
+		factories++
+		if account != "synthetic@example.test" {
+			t.Fatalf("unexpected account: %s", account)
+		}
+		return svc, nil
+	}
+	t.Cleanup(func() {
+		newSlidesService = orig
+		if factories != 1 {
+			t.Errorf("service factory called %d times", factories)
+		}
+	})
+	return &calls
+}
+
+func slidesTextRun(t *testing.T, limit int) (string, error) {
+	t.Helper()
+	var runErr error
+	out := captureStdout(t, func() {
+		ctx := outfmt.WithMode(context.Background(), outfmt.Mode{JSON: true})
+		cmd := SlidesReadPresentationTextCmd{PresentationID: "pres1", MaxBytes: limit}
+		runErr = cmd.Run(ctx, &RootFlags{Account: "synthetic@example.test"})
+	})
+	return out, runErr
+}
+
+const slidesTextFixture = `{"presentationId":"pres1","title":"Synthetic deck","revisionId":"rev_1","slides":[
+ {"objectId":"slide:1","pageElements":[
+  {"objectId":"top_1","shape":{"text":{"textElements":[{"textRun":{"content":"첫 줄\n"}},{"autoText":{"content":"2"}}]}}},
+  {"objectId":"group_1","elementGroup":{"children":[{"objectId":"group_2","elementGroup":{"children":[
+   {"objectId":"group_shape","shape":{"text":{"textElements":[{"textRun":{"content":"Grouped 한글"}}]}}},
+   {"objectId":"table_1","table":{"tableRows":[{"tableCells":[{"text":{"textElements":[{"textRun":{"content":"Cell A\n"}}]}},{"text":{"textElements":[]}}]},{"tableCells":[{"text":{"textElements":[{"textRun":{"content":"Cell B"}}]}}]}]}},
+   {"objectId":"word_art","wordArt":{"renderedText":"장식 제목"}}
+  ]}}]}},
+  {"objectId":"image_1","image":{"contentUrl":"https://private.invalid/DO_NOT_EMIT_IMAGE_METADATA","sourceUrl":"DO_NOT_EMIT_IMAGE_SOURCE"}},
+  {"objectId":"chart_1","sheetsChart":{"contentUrl":"DO_NOT_EMIT_CHART_METADATA"}}
+ ],"slideProperties":{"notesPage":{"pageElements":[
+  {"objectId":"note_body","shape":{"placeholder":{"type":"BODY"},"text":{"textElements":[{"textRun":{"content":"Body note\n"}}]}}},
+  {"objectId":"note_other","shape":{"placeholder":{"type":"SLIDE_NUMBER"},"text":{"textElements":[{"autoText":{"content":"1"}}]}}},
+  {"objectId":"note_group","elementGroup":{"children":[{"objectId":"note_free","shape":{"text":{"textElements":[{"textRun":{"content":"Other note"}}]}}}]}},
+  {"objectId":"note_table","table":{"tableRows":[{"tableCells":[{"text":{"textElements":[{"textRun":{"content":"Note cell"}}]}}]}]}}
+ ]}}},
+ {"objectId":"slide_2","pageElements":[]}
+]}`
+
+const slidesTextFinal = `{"presentationId":"pres1","revisionId":"rev_1","slides":[{"objectId":"slide:1"},{"objectId":"slide_2"}]}`
+
+func TestSlidesReadPresentationTextRecursiveAndNotes(t *testing.T) {
+	calls := slidesTextMock(t, []string{slidesTextFixture, slidesTextFinal}, http.StatusOK)
+	out, err := slidesTextRun(t, slidesTextMaxBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if *calls != 2 {
+		t.Fatalf("requests=%d", *calls)
+	}
+	if strings.Contains(out, "DO_NOT_EMIT") || strings.Contains(out, "private.invalid") {
+		t.Fatal("asset metadata leaked")
+	}
+	var doc slidesTextDocument
+	if err := json.Unmarshal([]byte(out), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if doc.SchemaVersion != 1 || doc.PresentationID != "pres1" || doc.RevisionID != "rev_1" || doc.SlideCount != 2 || !doc.RevisionAndOrderRechecked || !doc.SlideOrderRechecked || !doc.PartialText || len(doc.Limitations) != 6 {
+		t.Fatalf("bad document metadata: %+v", doc)
+	}
+	first := doc.Slides[0]
+	if first.ObjectID != "slide:1" || first.Number != 1 || doc.Slides[1].Number != 2 {
+		t.Fatal("slide order lost")
+	}
+	if len(first.Elements) != 6 || len(first.Notes) != 4 {
+		t.Fatalf("elements=%d notes=%d", len(first.Elements), len(first.Notes))
+	}
+	if first.Elements[0].Text != "첫 줄\n2" || first.Elements[1].Text != "Grouped 한글" || strings.Join(first.Elements[1].GroupPath, "/") != "group_1/group_2" {
+		t.Fatal("shape text or group path lost")
+	}
+	for i, want := range []struct {
+		row, cell int
+		text      string
+	}{{0, 0, "Cell A\n"}, {0, 1, ""}, {1, 0, "Cell B"}} {
+		cell := first.Elements[i+2]
+		if cell.Kind != "table_cell" || cell.RowIndex == nil || *cell.RowIndex != want.row || cell.CellIndex == nil || *cell.CellIndex != want.cell || cell.Text != want.text {
+			t.Fatalf("bad cell: %+v", cell)
+		}
+	}
+	if first.Elements[5].Kind != "word_art" || first.Elements[5].Text != "장식 제목" || strings.Join(first.Elements[5].GroupPath, "/") != "group_1/group_2" {
+		t.Fatal("grouped WordArt text lost")
+	}
+	if first.Notes[1].PlaceholderType != "SLIDE_NUMBER" || first.Notes[1].Text != "1" || first.Notes[2].GroupPath[0] != "note_group" {
+		t.Fatal("non-BODY notes lost")
+	}
+	if first.Notes[3].Kind != "table_cell" || first.Notes[3].Text != "Note cell" {
+		t.Fatal("notes table lost")
+	}
+	if doc.Slides[1].Elements == nil || doc.Slides[1].Notes == nil {
+		t.Fatal("empty arrays must not be null")
+	}
+	count := len(doc.Title)
+	for _, page := range doc.Slides {
+		for _, records := range [][]slidesTextRecord{page.Elements, page.Notes} {
+			for _, record := range records {
+				count += len(record.Text)
+			}
+		}
+	}
+	if doc.TextBytes != count {
+		t.Fatalf("UTF-8 bytes got %d want %d", doc.TextBytes, count)
+	}
+}
