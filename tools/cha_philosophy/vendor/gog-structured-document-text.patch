--- /dev/null
+++ b/internal/googleapi/docs_text.go
@@ -0,0 +1,63 @@
+package googleapi
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"golang.org/x/oauth2"
+	"google.golang.org/api/docs/v1"
+	"google.golang.org/api/option"
+	httptransport "google.golang.org/api/transport/http"
+
+	"github.com/steipete/gogcli/internal/googleauth"
+)
+
+var docsTextAccountOptions = optionsForAccount
+
+// NewDocsForTextRead preserves the existing auth and refresh-token lifecycle.
+// Only this newly constructed service gets a longer response-header timeout;
+// token exchange timeouts and all ordinary service factories remain unchanged.
+func NewDocsForTextRead(ctx context.Context, email string) (*docs.Service, error) {
+	opts, err := docsTextAccountOptions(ctx, googleauth.ServiceDocs, email)
+	if err != nil {
+		return nil, err
+	}
+	client, _, err := httptransport.NewClient(ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	readClient, err := cloneDocsTextReadClient(client)
+	if err != nil {
+		return nil, err
+	}
+	return docs.NewService(ctx, option.WithHTTPClient(readClient))
+}
+
+func cloneDocsTextReadClient(client *http.Client) (*http.Client, error) {
+	bad := errors.New("unexpected Docs text read transport")
+	if client == nil {
+		return nil, bad
+	}
+	retry, ok := client.Transport.(*RetryTransport)
+	if !ok || retry == nil {
+		return nil, bad
+	}
+	auth, ok := retry.Base.(*oauth2.Transport)
+	if !ok || auth == nil || auth.Source == nil {
+		return nil, bad
+	}
+	base, ok := auth.Base.(*http.Transport)
+	if !ok || base == nil {
+		return nil, bad
+	}
+	readBase := base.Clone()
+	readBase.ResponseHeaderTimeout = 120 * time.Second
+	readAuth := &oauth2.Transport{Source: auth.Source, Base: readBase}
+	readRetry := *retry
+	readRetry.Base = readAuth
+	readClient := *client
+	readClient.Transport = &readRetry
+	return &readClient, nil
+}
