+	out, err := docsTextRun(t, docsTextMaxBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if *calls != 3 {
+		t.Fatal("request count")
+	}
+	if strings.Contains(out, "DO_NOT_EMIT") {
