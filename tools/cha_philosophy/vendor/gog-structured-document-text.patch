@@ -0,0 +1,522 @@
+package cmd
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"google.golang.org/api/docs/v1"
+	api "google.golang.org/api/googleapi"
+
+	"github.com/steipete/gogcli/internal/googleapi"
+	"github.com/steipete/gogcli/internal/outfmt"
+)
+
+const (
+	docsTextMaxBytes     = 32 * 1024 * 1024
+	docsTextMaxNodes     = 200000
+	docsTextMaxTabs      = 1024
+	docsTextTabDepth     = 8
+	docsTextContentDepth = 16
+	docsTextPreview      = "PREVIEW_WITHOUT_SUGGESTIONS"
+	docsTextInline       = "SUGGESTIONS_INLINE"
+)
+
+var newDocsTextService = googleapi.NewDocsForTextRead
+var docsTextID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,256}$`)
+var docsTextObjectID = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,256}$`)
+
+type DocsReadDocumentTextCmd struct {
+	DocID    string `arg:"" name:"docId" help:"Native document ID"`
+	MaxBytes int    `name:"max-bytes" default:"33554432" help:"Total text and JSON bytes across both views (1024..33554432); excess fails"`
+}
+
+type docsTextTab struct {
+	TabID        string `json:"tabId"`
+	Title        string `json:"title"`
+	ParentTabID  string `json:"parentTabId"`
+	Index        int64  `json:"index"`
+	NestingLevel int64  `json:"nestingLevel"`
+}
+
+type docsTextRecord struct {
+	TabID                 string   `json:"tabId"`
+	Region                string   `json:"region"`
+	RegionID              string   `json:"regionId"`
+	Path                  []string `json:"path"`
+	Kind                  string   `json:"kind"`
+	Text                  string   `json:"text"`
+	StartIndex            int64    `json:"startIndex"`
+	EndIndex              int64    `json:"endIndex"`
+	SuggestedInsertionIDs []string `json:"suggestedInsertionIds"`
+	SuggestedDeletionIDs  []string `json:"suggestedDeletionIds"`
+	DisplayFallback       string   `json:"displayFallback,omitempty"`
+	FootnoteID            string   `json:"footnoteId,omitempty"`
+	FootnoteNumber        *string  `json:"footnoteNumber,omitempty"`
+}
+
+type docsTextView struct {
+	Mode      string           `json:"mode"`
+	Records   []docsTextRecord `json:"records"`
+	TextBytes int              `json:"textBytes"`
+}
+
+type docsTextOutput struct {
+	SchemaVersion            int            `json:"schemaVersion"`
+	DocumentID               string         `json:"documentId"`
+	Title                    string         `json:"title"`
+	RevisionID               string         `json:"revisionId"`
+	TabCount                 int            `json:"tabCount"`
+	Tabs                     []docsTextTab  `json:"tabs"`
+	Views                    []docsTextView `json:"views"`
+	TextBytes                int            `json:"textBytes"`
+	RevisionAndTabsRechecked bool           `json:"revisionAndTabsRechecked"`
+	TabHierarchyRechecked    bool           `json:"tabHierarchyRechecked"`
+	PartialText              bool           `json:"partialText"`
+	Limitations              []string       `json:"limitations"`
+}
+
+func docsTextTabFields(depth int, content bool) string {
+	fields := "tabProperties(tabId,title,index,parentTabId,nestingLevel)"
+	if content {
+		fields += ",documentTab(body,headers,footers,footnotes)"
+	}
+	if depth == 0 {
+		return fields + ",childTabs(tabProperties(tabId))"
+	}
+	return fields + ",childTabs(" + docsTextTabFields(depth-1, content) + ")"
+}
+
+func docsTextFields(content bool) api.Field {
+	return api.Field("documentId,title,revisionId,suggestionsViewMode,tabs(" + docsTextTabFields(docsTextTabDepth, content) + ")")
+}
+
+func docsTextError(err error) error {
+	var remote *api.Error
+	if errors.As(err, &remote) {
+		for _, detail := range remote.Errors {
+			switch detail.Reason {
+			case "rateLimitExceeded", "userRateLimitExceeded":
+				return errors.New("docs_text_rate_limited")
+			case "dailyLimitExceeded", "quotaExceeded", "storageQuotaExceeded":
+				return errors.New("docs_text_quota_exceeded")
+			}
+		}
+		switch remote.Code {
+		case 401:
+			return errors.New("docs_text_auth_required")
+		case 403:
+			return errors.New("docs_text_access_denied")
+		case 404:
+			return errors.New("docs_text_not_found")
+		case 429:
+			return errors.New("docs_text_rate_limited")
+		}
+	}
+	return errors.New("docs_text_read_failed")
+}
+
+func docsTextInventory(doc *docs.Document, id, mode string, content bool) ([]docsTextTab, error) {
+	if doc == nil || doc.DocumentId != id || doc.SuggestionsViewMode != mode {
+		return nil, errors.New("docs_text_identity_or_view_invalid")
+	}
+	result := make([]docsTextTab, 0)
+	seen := make(map[string]bool)
+	var visit func([]*docs.Tab, string, int) error
+	visit = func(tabs []*docs.Tab, parent string, depth int) error {
+		if depth > docsTextTabDepth && len(tabs) > 0 {
+			return errors.New("docs_text_tab_depth_exceeded")
+		}
+		for i, tab := range tabs {
+			if tab == nil || tab.TabProperties == nil {
+				return errors.New("docs_text_tab_inventory_invalid")
+			}
+			p := tab.TabProperties
+			if !docsTextObjectID.MatchString(p.TabId) || seen[p.TabId] || p.ParentTabId != parent || p.Index != int64(i) || p.NestingLevel != int64(depth) || (content && tab.DocumentTab == nil) {
+				return errors.New("docs_text_tab_inventory_invalid")
+			}
+			seen[p.TabId] = true
+			result = append(result, docsTextTab{TabID: p.TabId, Title: p.Title, ParentTabID: parent, Index: p.Index, NestingLevel: p.NestingLevel})
+			if len(result) > docsTextMaxTabs {
+				return errors.New("docs_text_tab_budget_exceeded")
+			}
+			if err := visit(tab.ChildTabs, p.TabId, depth+1); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := visit(doc.Tabs, "", 0); err != nil {
+		return nil, err
+	}
+	if len(result) == 0 {
+		return nil, errors.New("docs_text_tab_inventory_invalid")
+	}
+	return result, nil
+}
+
+type docsTextCollector struct{ bytes, nodes, limit int }
+
+func (c *docsTextCollector) node() error {
+	c.nodes++
+	if c.nodes > docsTextMaxNodes {
+		return errors.New("docs_text_node_budget_exceeded")
+	}
+	return nil
+}
+
+func (c *docsTextCollector) addBytes(text string) error {
+	if len(text) > c.limit-c.bytes {
+		return errors.New("docs_text_byte_budget_exceeded")
+	}
+	c.bytes += len(text)
+	return nil
+}
+
+func docsTextSuggestions(parent, own []string) ([]string, error) {
+	result := append([]string{}, parent...)
+	for _, id := range own {
+		if !docsTextObjectID.MatchString(id) {
+			return nil, errors.New("docs_text_response_invalid")
+		}
+		if !slices.Contains(result, id) {
+			result = append(result, id)
+		}
+	}
+	sort.Strings(result)
+	return result, nil
+}
+
+func docsTextPath(path []string, parts ...string) []string {
+	return append(append([]string{}, path...), parts...)
+}
+
+func (c *docsTextCollector) content(view *docsTextView, tabID, region, regionID string, content []*docs.StructuralElement, path, insertion, deletion []string, depth int) error {
+	if depth > docsTextContentDepth && len(content) > 0 {
+		return errors.New("docs_text_content_depth_exceeded")
+	}
+	for index, element := range content {
+		if err := c.node(); err != nil {
+			return err
+		}
+		if element == nil {
+			return errors.New("docs_text_response_invalid")
+		}
+		location := docsTextPath(path, "content", strconv.Itoa(index))
+		switch {
+		case element.Paragraph != nil:
+			for pi, p := range element.Paragraph.Elements {
+				if err := c.node(); err != nil {
+					return err
+				}
+				if p == nil || p.StartIndex < 0 || p.EndIndex < p.StartIndex {
+					return errors.New("docs_text_response_invalid")
+				}
+				r := docsTextRecord{TabID: tabID, Region: region, RegionID: regionID, Path: docsTextPath(location, "elements", strconv.Itoa(pi)), StartIndex: p.StartIndex, EndIndex: p.EndIndex}
+				var ins, del []string
+				switch {
+				case p.TextRun != nil:
+					r.Kind = "text"
+					r.Text = p.TextRun.Content
+					ins = p.TextRun.SuggestedInsertionIds
+					del = p.TextRun.SuggestedDeletionIds
+				case p.RichLink != nil:
+					if p.RichLink.RichLinkProperties == nil {
+						return errors.New("docs_text_response_invalid")
+					}
+					r.Kind = "rich_link"
+					r.Text = p.RichLink.RichLinkProperties.Title
+					ins = p.RichLink.SuggestedInsertionIds
+					del = p.RichLink.SuggestedDeletionIds
+				case p.Person != nil:
+					if p.Person.PersonProperties == nil {
+						return errors.New("docs_text_response_invalid")
+					}
+					r.Kind = "person"
+					r.Text = p.Person.PersonProperties.Name
+					if r.Text == "" {
+						r.Text = p.Person.PersonProperties.Email
+						r.DisplayFallback = "email"
+					}
+					ins = p.Person.SuggestedInsertionIds
+					del = p.Person.SuggestedDeletionIds
+				case p.DateElement != nil:
+					if p.DateElement.DateElementProperties == nil {
+						return errors.New("docs_text_response_invalid")
+					}
+					r.Kind = "date"
+					r.Text = p.DateElement.DateElementProperties.DisplayText
+					ins = p.DateElement.SuggestedInsertionIds
+					del = p.DateElement.SuggestedDeletionIds
+				case p.FootnoteReference != nil:
+					r.Kind = "footnote_reference"
+					r.Text = p.FootnoteReference.FootnoteNumber
+					r.FootnoteID = p.FootnoteReference.FootnoteId
+					r.FootnoteNumber = &p.FootnoteReference.FootnoteNumber
+					if !docsTextObjectID.MatchString(r.FootnoteID) {
+						return errors.New("docs_text_response_invalid")
+					}
+					ins = p.FootnoteReference.SuggestedInsertionIds
+					del = p.FootnoteReference.SuggestedDeletionIds
+				case p.Equation != nil:
+					r.Kind = "unsupported_equation"
+					ins = p.Equation.SuggestedInsertionIds
+					del = p.Equation.SuggestedDeletionIds
+				case p.AutoText != nil:
+					r.Kind = "unsupported_auto_text"
+					ins = p.AutoText.SuggestedInsertionIds
+					del = p.AutoText.SuggestedDeletionIds
+				case p.InlineObjectElement != nil:
+					r.Kind = "unsupported_inline_object"
+					ins = p.InlineObjectElement.SuggestedInsertionIds
+					del = p.InlineObjectElement.SuggestedDeletionIds
+				default:
+					continue // Break/rule elements do not expose text.
+				}
+				if r.Kind == "text" && r.Text == "" {
+					continue
+				}
+				var err error
+				r.SuggestedInsertionIDs, err = docsTextSuggestions(insertion, ins)
+				if err != nil {
+					return err
+				}
+				r.SuggestedDeletionIDs, err = docsTextSuggestions(deletion, del)
+				if err != nil {
+					return err
+				}
+				if err = c.addBytes(r.Text); err != nil {
+					return err
+				}
+				view.TextBytes += len(r.Text)
+				view.Records = append(view.Records, r)
+			}
+		case element.Table != nil:
+			table := element.Table
+			ins, err := docsTextSuggestions(insertion, table.SuggestedInsertionIds)
+			if err != nil {
+				return err
+			}
+			del, err := docsTextSuggestions(deletion, table.SuggestedDeletionIds)
+			if err != nil {
+				return err
+			}
+			for ri, row := range table.TableRows {
+				if err = c.node(); err != nil {
+					return err
+				}
+				if row == nil {
+					return errors.New("docs_text_response_invalid")
+				}
+				riIns, err := docsTextSuggestions(ins, row.SuggestedInsertionIds)
+				if err != nil {
+					return err
+				}
+				riDel, err := docsTextSuggestions(del, row.SuggestedDeletionIds)
+				if err != nil {
+					return err
+				}
+				for ci, cell := range row.TableCells {
+					if err = c.node(); err != nil {
+						return err
+					}
+					if cell == nil {
+						return errors.New("docs_text_response_invalid")
+					}
+					ciIns, err := docsTextSuggestions(riIns, cell.SuggestedInsertionIds)
+					if err != nil {
+						return err
+					}
+					ciDel, err := docsTextSuggestions(riDel, cell.SuggestedDeletionIds)
+					if err != nil {
+						return err
+					}
+					if err = c.content(view, tabID, region, regionID, cell.Content, docsTextPath(location, "tableRows", strconv.Itoa(ri), "tableCells", strconv.Itoa(ci)), ciIns, ciDel, depth+1); err != nil {
+						return err
+					}
+				}
+			}
+		case element.TableOfContents != nil:
+			ins, err := docsTextSuggestions(insertion, element.TableOfContents.SuggestedInsertionIds)
+			if err != nil {
+				return err
+			}
+			del, err := docsTextSuggestions(deletion, element.TableOfContents.SuggestedDeletionIds)
+			if err != nil {
+				return err
+			}
+			if err = c.content(view, tabID, region, regionID, element.TableOfContents.Content, docsTextPath(location, "tableOfContents"), ins, del, depth+1); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (c *docsTextCollector) view(doc *docs.Document) (docsTextView, error) {
+	view := docsTextView{Mode: doc.SuggestionsViewMode, Records: make([]docsTextRecord, 0)}
+	var visit func([]*docs.Tab) error
+	visit = func(tabs []*docs.Tab) error {
+		for _, tab := range tabs {
+			if err := c.node(); err != nil {
+				return err
+			}
+			dt := tab.DocumentTab
+			id := tab.TabProperties.TabId
+			if dt.Body != nil {
+				if err := c.content(&view, id, "body", "", dt.Body.Content, nil, nil, nil, 0); err != nil {
+					return err
+				}
+			}
+			regions := map[string]map[string][]*docs.StructuralElement{"header": {}, "footer": {}, "footnote": {}}
+			for key, value := range dt.Headers {
+				if value.HeaderId != key {
+					return errors.New("docs_text_response_invalid")
+				}
+				regions["header"][key] = value.Content
+			}
+			for key, value := range dt.Footers {
+				if value.FooterId != key {
+					return errors.New("docs_text_response_invalid")
+				}
+				regions["footer"][key] = value.Content
+			}
+			for key, value := range dt.Footnotes {
+				if value.FootnoteId != key {
+					return errors.New("docs_text_response_invalid")
+				}
+				regions["footnote"][key] = value.Content
+			}
+			for _, region := range []string{"header", "footer", "footnote"} {
+				ids := make([]string, 0, len(regions[region]))
+				for key := range regions[region] {
+					ids = append(ids, key)
+				}
+				sort.Strings(ids)
+				for _, key := range ids {
+					if !docsTextObjectID.MatchString(key) {
+						return errors.New("docs_text_response_invalid")
+					}
+					if err := c.node(); err != nil {
+						return err
+					}
+					if err := c.content(&view, id, region, key, regions[region][key], nil, nil, nil, 0); err != nil {
+						return err
+					}
+				}
+			}
+			if err := visit(tab.ChildTabs); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	err := visit(doc.Tabs)
+	return view, err
+}
+
+func (c *DocsReadDocumentTextCmd) Run(ctx context.Context, flags *RootFlags) error {
+	id := strings.TrimSpace(c.DocID)
+	if !docsTextID.MatchString(id) {
+		return usage("invalid docId")
+	}
+	if c.MaxBytes < 1024 || c.MaxBytes > docsTextMaxBytes {
+		return usage("max-bytes must be between 1024 and 33554432")
+	}
+	if !outfmt.IsJSON(ctx) {
+		return usage("read-document-text requires --json")
+	}
+	if projection, ok := outfmt.JSONTransformFromContext(ctx); ok && (projection.ResultsOnly || len(projection.Select) > 0) {
+		return usage("read-document-text requires the complete JSON schema without --select or --results-only")
+	}
+	account, err := requireAccount(flags)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 240*time.Second)
+	defer cancel()
+	svc, err := newDocsTextService(ctx, account)
+	if err != nil || svc == nil {
+		return errors.New("docs_text_auth_unavailable")
+	}
+	get := func(mode string, content bool) (*docs.Document, []docsTextTab, error) {
+		doc, e := svc.Documents.Get(id).IncludeTabsContent(true).SuggestionsViewMode(mode).Fields(docsTextFields(content)).Context(ctx).Do()
+		if e != nil {
+			safe := docsTextError(e)
+			if safe.Error() == "docs_text_access_denied" {
+				if !content {
+					safe = errors.New("docs_text_verification_access_denied")
+				} else if mode == docsTextInline {
+					safe = errors.New("docs_text_inline_access_denied")
+				} else {
+					safe = errors.New("docs_text_preview_access_denied")
+				}
+			}
+			return nil, nil, safe
+		}
+		tabs, e := docsTextInventory(doc, id, mode, content)
+		return doc, tabs, e
+	}
+	first, tabs, err := get(docsTextPreview, true)
+	if err != nil {
+		return err
+	}
+	collector := docsTextCollector{limit: c.MaxBytes}
+	if err = collector.addBytes(first.Title); err != nil {
+		return err
+	}
+	for _, tab := range tabs {
+		if err = collector.addBytes(tab.Title); err != nil {
+			return err
+		}
+	}
+	preview, err := collector.view(first)
+	if err != nil {
+		return err
+	}
+	second, secondTabs, err := get(docsTextInline, true)
+	if err != nil {
+		return err
+	}
+	if second.RevisionId != first.RevisionId || second.Title != first.Title || !reflect.DeepEqual(tabs, secondTabs) {
+		return errors.New("docs_text_changed_during_read")
+	}
+	inline, err := collector.view(second)
+	if err != nil {
+		return err
+	}
+	final, finalTabs, err := get(docsTextPreview, false)
+	if err != nil {
+		return err
+	}
+	if final.RevisionId != first.RevisionId || final.Title != first.Title || !reflect.DeepEqual(tabs, finalTabs) {
+		return errors.New("docs_text_changed_during_read")
+	}
+	output := docsTextOutput{SchemaVersion: 1, DocumentID: id, Title: first.Title, RevisionID: first.RevisionId, TabCount: len(tabs), Tabs: tabs, Views: []docsTextView{preview, inline}, TextBytes: collector.bytes, RevisionAndTabsRechecked: first.RevisionId != "", TabHierarchyRechecked: true, PartialText: true,
+		Limitations: []string{"images_ocr_and_embedded_drawings_not_extracted", "embedded_object_alt_text_not_extracted", "equations_not_rendered", "automatic_page_numbers_not_rendered", "list_numbering_and_layout_not_rendered", "text_style_and_hyperlink_targets_not_extracted", "suggestion_style_changes_not_interpreted", "views_are_alternative_representations_not_independent_evidence", "source_text_requires_consumer_sanitization"}}
+	if first.RevisionId == "" {
+		output.Limitations = append(output.Limitations, "revision_id_unavailable")
+	}
+	// Input uses the SDK decoder; no claim of streaming-bounded input memory.
+	// Raw body styles/URLs never reach stdout; emit only the typed projection.
+	var encoded bytes.Buffer
+	encoder := json.NewEncoder(&encoded)
+	encoder.SetEscapeHTML(false)
+	if err = encoder.Encode(output); err != nil {
+		return errors.New("docs_text_output_failed")
+	}
+	if encoded.Len() > c.MaxBytes {
+		return errors.New("docs_text_byte_budget_exceeded")
+	}
+	_, err = os.Stdout.Write(encoded.Bytes())
+	return err
+}
