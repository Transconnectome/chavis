+func TestSlidesReadPresentationTextBoundaries(t *testing.T) {
+	t.Run("text_bytes", func(t *testing.T) {
+		body := strings.Replace(slidesTextFixture, "Grouped 한글", strings.Repeat("한", 400), 1)
+		calls := slidesTextMock(t, []string{body}, http.StatusOK)
+		out, err := slidesTextRun(t, 1024)
+		if err == nil || err.Error() != "slides_text_byte_budget_exceeded" || out != "" || *calls != 1 {
+			t.Fatalf("out=%q err=%v calls=%d", out, err, *calls)
+		}
+	})
+	t.Run("json_bytes", func(t *testing.T) {
+		slidesTextMock(t, []string{slidesTextFixture, slidesTextFinal}, http.StatusOK)
+		out, err := slidesTextRun(t, 1024)
+		if err == nil || err.Error() != "slides_text_byte_budget_exceeded" || out != "" {
+			t.Fatalf("out=%q err=%v", out, err)
+		}
+	})
+	t.Run("group_depth", func(t *testing.T) {
+		child := &slides.PageElement{ObjectId: "leaf", Shape: &slides.Shape{Text: &slides.TextContent{TextElements: []*slides.TextElement{{TextRun: &slides.TextRun{Content: "leaf"}}}}}}
+		for range slidesTextMaxDepth {
+			child = &slides.PageElement{ObjectId: "group", ElementGroup: &slides.Group{Children: []*slides.PageElement{child}}}
+		}
+		c := slidesTextCollector{limit: 1024}
+		records, err := c.elements([]*slides.PageElement{child}, nil)
+		if err != nil || len(records) != 1 || len(records[0].GroupPath) != slidesTextMaxDepth {
+			t.Fatalf("max depth: %v", err)
+		}
+		child = &slides.PageElement{ObjectId: "group", ElementGroup: &slides.Group{Children: []*slides.PageElement{child}}}
+		_, err = c.elements([]*slides.PageElement{child}, nil)
+		if err == nil || err.Error() != "slides_text_group_depth_exceeded" {
+			t.Fatalf("overflow: %v", err)
+		}
+	})
+	t.Run("nodes", func(t *testing.T) {
+		c := slidesTextCollector{limit: 1024, nodes: slidesTextMaxNodes}
+		_, err := c.text(&slides.TextContent{TextElements: []*slides.TextElement{{TextRun: &slides.TextRun{Content: ""}}}})
+		if err == nil || err.Error() != "slides_text_node_budget_exceeded" {
+			t.Fatalf("node budget: %v", err)
+		}
+	})
+	t.Run("slides", func(t *testing.T) {
+		_, err := slidesTextInventory(&slides.Presentation{PresentationId: "pres1", RevisionId: "rev", Slides: make([]*slides.Page, slidesTextMaxSlides+1)}, "pres1")
+		if err == nil || err.Error() != "slides_text_slide_budget_exceeded" {
+			t.Fatalf("slide budget: %v", err)
+		}
+	})
+}
+
+func TestSlidesReadPresentationTextSafeErrors(t *testing.T) {
+	for _, tc := range []struct {
+		code int
+		want string
+	}{{401, "slides_text_auth_required"}, {403, "slides_text_access_denied"}, {404, "slides_text_not_found"}, {429, "slides_text_rate_limited"}, {500, "slides_text_read_failed"}} {
+		t.Run(tc.want, func(t *testing.T) {
+			slidesTextMock(t, []string{`{"error":{"message":"DO_NOT_EMIT_PROVIDER_PAYLOAD","code":` + httpStatusNumber(tc.code) + `}}`}, tc.code)
+			out, err := slidesTextRun(t, slidesTextMaxBytes)
+			if err == nil || err.Error() != tc.want || out != "" {
+				t.Fatalf("out=%q err=%v", out, err)
+			}
+		})
+	}
+	if got := slidesTextReadError(errors.New("DO_NOT_EMIT_AUTH_SECRET")).Error(); got != "slides_text_read_failed" {
+		t.Fatal(got)
+	}
+	for _, reason := range []string{"rateLimitExceeded", "userRateLimitExceeded", "dailyLimitExceeded", "quotaExceeded", "storageQuotaExceeded"} {
+		t.Run(reason, func(t *testing.T) {
+			body := `{"error":{"code":403,"message":"DO_NOT_EMIT_PROVIDER_PAYLOAD","errors":[{"reason":"` + reason + `"}]}}`
+			slidesTextMock(t, []string{body}, http.StatusForbidden)
+			out, err := slidesTextRun(t, slidesTextMaxBytes)
+			want := "slides_text_quota_exceeded"
+			if reason == "rateLimitExceeded" || reason == "userRateLimitExceeded" {
+				want = "slides_text_rate_limited"
+			}
+			if err == nil || err.Error() != want || out != "" {
+				t.Fatalf("out=%q err=%v", out, err)
+			}
+		})
+	}
+}
+
+func httpStatusNumber(code int) string { b, _ := json.Marshal(code); return string(b) }
+
+func TestSlidesReadPresentationTextRejectsArgumentsBeforeAuth(t *testing.T) {
+	orig := newSlidesService
+	newSlidesService = func(context.Context, string) (*slides.Service, error) {
+		t.Fatal("unexpected auth factory")
+		return nil, nil
+	}
+	t.Cleanup(func() { newSlidesService = orig })
+	for _, tc := range []struct {
+		id    string
+		bytes int
+		json  bool
+	}{{"bad/id", 1024, true}, {"pres1", 1023, true}, {"pres1", slidesTextMaxBytes + 1, true}, {"pres1", 1024, false}} {
+		ctx := outfmt.WithMode(context.Background(), outfmt.Mode{JSON: tc.json})
+		cmd := SlidesReadPresentationTextCmd{PresentationID: tc.id, MaxBytes: tc.bytes}
+		if err := cmd.Run(ctx, &RootFlags{Account: "synthetic@example.test"}); err == nil {
+			t.Fatal("expected validation error")
+		}
+	}
+}
