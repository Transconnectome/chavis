+  {"objectId":"note_group","elementGroup":{"children":[{"objectId":"note_free","shape":{"text":{"textElements":[{"textRun":{"content":"Other note"}}]}}}]}},
+  {"objectId":"note_table","table":{"tableRows":[{"tableCells":[{"text":{"textElements":[{"textRun":{"content":"Note cell"}}]}}]}]}}
