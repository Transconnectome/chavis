@@ -0,0 +1,84 @@
+package googleapi
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+	"time"
+
+	"golang.org/x/oauth2"
+	"google.golang.org/api/option"
+
+	"github.com/steipete/gogcli/internal/googleauth"
+)
+
+type docsTextTestTokenSource struct{ calls int }
+
+func (s *docsTextTestTokenSource) Token() (*oauth2.Token, error) {
+	s.calls++
+	return nil, errors.New("token must not be requested by client construction")
+}
+
+func TestDocsTextReadClientClone(t *testing.T) {
+	source := &docsTextTestTokenSource{}
+	base := newBaseTransport()
+	auth := &oauth2.Transport{Source: source, Base: base}
+	retry := NewRetryTransport(auth)
+	retry.MaxRetries429 = 7
+	retry.MaxRetries5xx = 3
+	retry.BaseDelay = 13 * time.Millisecond
+	client := &http.Client{Transport: retry}
+	got, err := cloneDocsTextReadClient(client)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := got.Transport.(*RetryTransport)
+	a := r.Base.(*oauth2.Transport)
+	b := a.Base.(*http.Transport)
+	if got == client || r == retry || a == auth || b == base {
+		t.Fatal("transport chain not cloned")
+	}
+	if a.Source != source || source.calls != 0 {
+		t.Fatal("existing token source not preserved")
+	}
+	if b.ResponseHeaderTimeout != 120*time.Second || base.ResponseHeaderTimeout != 30*time.Second || got.Timeout != 0 {
+		t.Fatal("timeout scope changed incorrectly")
+	}
+	if r.MaxRetries429 != retry.MaxRetries429 || r.MaxRetries5xx != retry.MaxRetries5xx || r.BaseDelay != retry.BaseDelay || r.CircuitBreaker != retry.CircuitBreaker {
+		t.Fatal("retry settings changed")
+	}
+	if b.TLSClientConfig == base.TLSClientConfig || b.TLSClientConfig.MinVersion != base.TLSClientConfig.MinVersion {
+		t.Fatal("TLS transport clone lost")
+	}
+	if tokenExchangeTimeout != 30*time.Second {
+		t.Fatal("refresh timeout changed")
+	}
+}
+
+func TestDocsTextReadClientRejectsUnexpectedTransport(t *testing.T) {
+	for _, client := range []*http.Client{nil, {}, {Transport: &http.Transport{}}, {Transport: &RetryTransport{}}, {Transport: &RetryTransport{Base: &oauth2.Transport{Source: &docsTextTestTokenSource{}}}}} {
+		if _, err := cloneDocsTextReadClient(client); err == nil {
+			t.Fatal("unexpected transport accepted")
+		}
+	}
+}
+
+func TestDocsTextReadFactoryUsesExistingOptionsOnce(t *testing.T) {
+	orig := docsTextAccountOptions
+	t.Cleanup(func() { docsTextAccountOptions = orig })
+	source := &docsTextTestTokenSource{}
+	calls := 0
+	ctx := context.WithValue(context.Background(), struct{}{}, "auth-context-marker")
+	docsTextAccountOptions = func(got context.Context, service googleauth.Service, email string) ([]option.ClientOption, error) {
+		calls++
+		if got != ctx || service != googleauth.ServiceDocs || email != "synthetic@example.test" {
+			t.Fatal("auth routing changed")
+		}
+		return []option.ClientOption{option.WithHTTPClient(&http.Client{Transport: NewRetryTransport(&oauth2.Transport{Source: source, Base: newBaseTransport()})})}, nil
+	}
+	svc, err := NewDocsForTextRead(ctx, "synthetic@example.test")
+	if err != nil || svc == nil || calls != 1 || source.calls != 0 {
+		t.Fatalf("construction err=%v calls=%d token calls=%d", err, calls, source.calls)
+	}
+}
