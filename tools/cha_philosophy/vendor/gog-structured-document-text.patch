+	if result.SchemaVersion != 1 || result.TabCount != 2 || result.Tabs[1].ParentTabID != "t1" || result.Tabs[1].NestingLevel != 1 || !result.TabHierarchyRechecked || !result.RevisionAndTabsRechecked || !result.PartialText || len(result.Views) != 2 || len(result.Limitations) != 9 {
