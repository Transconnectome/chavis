+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	api "google.golang.org/api/googleapi"
+	"google.golang.org/api/slides/v1"
+
+	"github.com/steipete/gogcli/internal/outfmt"
+)
+
+const (
+	slidesTextMaxBytes  = 32 * 1024 * 1024
+	slidesTextMaxDepth  = 8
+	slidesTextMaxSlides = 4096
+	slidesTextMaxNodes  = 200000
+)
+
+var slidesTextID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,256}$`)
+var slidesTextObjectID = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_:-]{0,255}$`)
+
+type SlidesReadPresentationTextCmd struct {
+	PresentationID string `arg:"" name:"presentationId" help:"Native presentation ID"`
+	MaxBytes       int    `name:"max-bytes" default:"33554432" help:"Maximum text and JSON output bytes (1024..33554432); excess fails without output"`
+}
+
+type slidesTextRecord struct {
+	ObjectID        string   `json:"objectId"`
+	Kind            string   `json:"kind"`
+	GroupPath       []string `json:"groupPath"`
+	PlaceholderType string   `json:"placeholderType,omitempty"`
+	RowIndex        *int     `json:"rowIndex,omitempty"`
+	CellIndex       *int     `json:"cellIndex,omitempty"`
+	Text            string   `json:"text"`
+}
+
+type slidesTextPage struct {
+	ObjectID string             `json:"objectId"`
+	Number   int                `json:"number"`
+	Elements []slidesTextRecord `json:"elements"`
+	Notes    []slidesTextRecord `json:"notes"`
+}
+
+type slidesTextDocument struct {
+	SchemaVersion             int              `json:"schemaVersion"`
+	PresentationID            string           `json:"presentationId"`
+	Title                     string           `json:"title"`
+	RevisionID                string           `json:"revisionId"`
+	SlideCount                int              `json:"slideCount"`
+	Slides                    []slidesTextPage `json:"slides"`
+	TextBytes                 int              `json:"textBytes"`
+	RevisionAndOrderRechecked bool             `json:"revisionAndOrderRechecked"`
+	SlideOrderRechecked       bool             `json:"slideOrderRechecked"`
+	PartialText               bool             `json:"partialText"`
+	Limitations               []string         `json:"limitations"`
+}
+
+// Request only textual fields. At the depth boundary request child IDs so an
+// additional group level is detected and rejected, never silently omitted.
+func slidesTextFields(depth int) string {
+	text := "text(textElements(textRun(content),autoText(content)))"
+	elements := "objectId,shape(placeholder(type)," + text + "),wordArt(renderedText),table(tableRows(tableCells(" + text + ")))"
+	if depth == 0 {
+		return elements + ",elementGroup(children(objectId))"
+	}
+	return elements + ",elementGroup(children(" + slidesTextFields(depth-1) + "))"
+}
+
+func slidesTextPresentationFields() api.Field {
+	elements := slidesTextFields(slidesTextMaxDepth)
+	return api.Field("presentationId,title,revisionId,slides(objectId,pageElements(" + elements +
+		"),slideProperties(notesPage(pageElements(" + elements + "))))")
+}
+
+func slidesTextReadError(err error) error {
+	var remote *api.Error
+	if errors.As(err, &remote) {
+		for _, detail := range remote.Errors {
+			switch detail.Reason {
+			case "rateLimitExceeded", "userRateLimitExceeded":
+				return errors.New("slides_text_rate_limited")
+			case "dailyLimitExceeded", "quotaExceeded", "storageQuotaExceeded":
+				return errors.New("slides_text_quota_exceeded")
+			}
+		}
+		switch remote.Code {
+		case 401:
+			return errors.New("slides_text_auth_required")
+		case 403:
+			return errors.New("slides_text_access_denied")
+		case 404:
+			return errors.New("slides_text_not_found")
+		case 429:
+			return errors.New("slides_text_rate_limited")
+		}
+	}
+	// Do not echo response bodies, URLs, auth diagnostics or provider payloads.
+	return errors.New("slides_text_read_failed")
+}
+
+func slidesTextInventory(p *slides.Presentation, id string) ([]string, error) {
+	if p == nil || p.PresentationId != id {
+		return nil, errors.New("slides_text_identity_or_revision_missing")
+	}
+	if len(p.Slides) > slidesTextMaxSlides {
+		return nil, errors.New("slides_text_slide_budget_exceeded")
+	}
+	ids := make([]string, 0, len(p.Slides))
+	seen := make(map[string]bool)
+	for _, page := range p.Slides {
+		if page == nil || !slidesTextObjectID.MatchString(page.ObjectId) || seen[page.ObjectId] {
+			return nil, errors.New("slides_text_inventory_invalid")
+		}
+		seen[page.ObjectId] = true
+		ids = append(ids, page.ObjectId)
+	}
+	return ids, nil
+}
+
+type slidesTextCollector struct {
+	bytes int
+	nodes int
+	limit int
+}
+
+func (c *slidesTextCollector) text(content *slides.TextContent) (string, error) {
+	var result strings.Builder
+	if content != nil {
+		for _, element := range content.TextElements {
+			if err := c.countNode(); err != nil {
+				return "", err
+			}
+			if element == nil {
+				return "", errors.New("slides_text_response_invalid")
+			}
+			var value string
+			if element.TextRun != nil {
+				value = element.TextRun.Content
+			} else if element.AutoText != nil {
+				value = element.AutoText.Content
+			}
+			if len(value) > c.limit-c.bytes {
+				return "", errors.New("slides_text_byte_budget_exceeded")
+			}
+			c.bytes += len(value)
+			result.WriteString(value)
+		}
+	}
+	return result.String(), nil
+}
+
+func (c *slidesTextCollector) countNode() error {
+	c.nodes++
+	if c.nodes > slidesTextMaxNodes {
+		return errors.New("slides_text_node_budget_exceeded")
+	}
+	return nil
+}
+
+// Cell indices are API row/cell-array positions, not inferred visual geometry.
+// Keep individual records and the ordered group path; do not flatten table order
+// into a claim about the presentation's rendered reading order.
+func (c *slidesTextCollector) elements(elements []*slides.PageElement, groups []string) ([]slidesTextRecord, error) {
+	result := make([]slidesTextRecord, 0)
+	for _, element := range elements {
+		if err := c.countNode(); err != nil {
+			return nil, err
+		}
+		if element == nil || !slidesTextObjectID.MatchString(element.ObjectId) {
+			return nil, errors.New("slides_text_response_invalid")
+		}
+		path := append([]string{}, groups...)
+		if element.Shape != nil {
+			text, err := c.text(element.Shape.Text)
+			if err != nil {
+				return nil, err
+			}
+			if text != "" {
+				record := slidesTextRecord{ObjectID: element.ObjectId, Kind: "shape", GroupPath: path, Text: text}
+				if element.Shape.Placeholder != nil {
+					record.PlaceholderType = element.Shape.Placeholder.Type
+				}
+				result = append(result, record)
+			}
+		}
+		if element.Table != nil {
+			for ri, row := range element.Table.TableRows {
+				if err := c.countNode(); err != nil {
+					return nil, err
+				}
+				if row == nil {
+					return nil, errors.New("slides_text_response_invalid")
+				}
+				for ci, cell := range row.TableCells {
+					if err := c.countNode(); err != nil {
+						return nil, err
+					}
+					if cell == nil {
+						return nil, errors.New("slides_text_response_invalid")
+					}
+					text, err := c.text(cell.Text)
+					if err != nil {
+						return nil, err
+					}
+					// Preserve empty cells too: their positions are structural.
+					result = append(result, slidesTextRecord{ObjectID: element.ObjectId, Kind: "table_cell", GroupPath: path, RowIndex: &ri, CellIndex: &ci, Text: text})
+				}
+			}
+		}
+		if element.WordArt != nil && element.WordArt.RenderedText != "" {
+			text := element.WordArt.RenderedText
+			if len(text) > c.limit-c.bytes {
+				return nil, errors.New("slides_text_byte_budget_exceeded")
+			}
+			c.bytes += len(text)
+			result = append(result, slidesTextRecord{ObjectID: element.ObjectId, Kind: "word_art", GroupPath: path, Text: text})
+		}
+		if element.ElementGroup != nil && len(element.ElementGroup.Children) > 0 {
+			if len(groups) >= slidesTextMaxDepth {
+				return nil, errors.New("slides_text_group_depth_exceeded")
+			}
+			children, err := c.elements(element.ElementGroup.Children, append(path, element.ObjectId))
+			if err != nil {
+				return nil, err
+			}
+			result = append(result, children...)
+		}
+	}
+	return result, nil
+}
+
+func (c *SlidesReadPresentationTextCmd) Run(ctx context.Context, flags *RootFlags) error {
+	id := strings.TrimSpace(c.PresentationID)
+	if !slidesTextID.MatchString(id) {
+		return usage("invalid presentationId")
+	}
+	if c.MaxBytes < 1024 || c.MaxBytes > slidesTextMaxBytes {
+		return usage("max-bytes must be between 1024 and 33554432")
+	}
+	if !outfmt.IsJSON(ctx) {
+		return usage("read-presentation-text requires --json")
+	}
+	account, err := requireAccount(flags)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 90*time.Second)
+	defer cancel()
+	// Same factory and OAuth/refresh/keyring lifecycle as read-slide. No new
+	// scopes, auth flow, token cache, credential export or second client.
+	svc, err := newSlidesService(ctx, account)
+	if err != nil || svc == nil {
+		return errors.New("slides_text_auth_unavailable")
+	}
+	presentation, err := svc.Presentations.Get(id).Fields(slidesTextPresentationFields()).Context(ctx).Do()
+	if err != nil {
+		return slidesTextReadError(err)
+	}
+	ids, err := slidesTextInventory(presentation, id)
+	if err != nil {
+		return err
+	}
+	collector := slidesTextCollector{limit: c.MaxBytes, bytes: len(presentation.Title)}
+	if collector.bytes > collector.limit {
+		return errors.New("slides_text_byte_budget_exceeded")
+	}
+	document := slidesTextDocument{SchemaVersion: 1, PresentationID: id, Title: presentation.Title, RevisionID: presentation.RevisionId,
+		SlideCount: len(ids), Slides: make([]slidesTextPage, 0, len(ids)), PartialText: true,
+		Limitations: []string{"images_and_ocr_not_extracted", "charts_and_embedded_media_not_extracted", "layouts_masters_and_notes_master_not_extracted",
+			"rendered_reading_order_and_table_geometry_not_verified", "text_style_and_hyperlink_targets_not_extracted", "source_text_requires_consumer_sanitization"}}
+	for i, page := range presentation.Slides {
+		text, err := collector.elements(page.PageElements, nil)
+		if err != nil {
+			return err
+		}
+		notes := make([]slidesTextRecord, 0)
+		if page.SlideProperties != nil && page.SlideProperties.NotesPage != nil {
+			notes, err = collector.elements(page.SlideProperties.NotesPage.PageElements, nil)
+			if err != nil {
+				return err
+			}
+		}
+		document.Slides = append(document.Slides, slidesTextPage{ObjectID: page.ObjectId, Number: i + 1, Elements: text, Notes: notes})
+	}
+	final, err := svc.Presentations.Get(id).Fields("presentationId,revisionId,slides(objectId)").Context(ctx).Do()
+	if err != nil {
+		return slidesTextReadError(err)
+	}
+	finalIDs, err := slidesTextInventory(final, id)
+	if err != nil {
+		return err
+	}
+	if presentation.RevisionId != final.RevisionId || !slices.Equal(ids, finalIDs) {
+		return errors.New("slides_text_changed_during_read")
+	}
+	document.TextBytes = collector.bytes
+	document.SlideOrderRechecked = true
+	document.RevisionAndOrderRechecked = presentation.RevisionId != ""
+	if presentation.RevisionId == "" {
+		document.Limitations = append(document.Limitations, "revision_id_unavailable")
+	}
+	// Buffer before emitting: a budget or revision failure cannot leave partial
+	// source text on stdout. The SDK's input JSON decode is not streaming-capped.
+	var encoded bytes.Buffer
+	if err := outfmt.WriteJSON(ctx, &encoded, document); err != nil {
+		return errors.New("slides_text_output_failed")
+	}
+	if encoded.Len() > c.MaxBytes {
+		return errors.New("slides_text_byte_budget_exceeded")
+	}
+	_, err = os.Stdout.Write(encoded.Bytes())
+	return err
+}
