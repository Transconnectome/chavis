+)
+
+type slidesTextRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f slidesTextRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+// All requests stay in memory. Replacing the entire service factory and using
+// an explicit account avoids the real OAuth, ADC, keyring and HTTP paths.
+func slidesTextMock(t *testing.T, bodies []string, status int) *int {
+	t.Helper()
+	calls, factories := 0, 0
+	client := &http.Client{Transport: slidesTextRoundTripper(func(r *http.Request) (*http.Response, error) {
+		if r.Method != http.MethodGet || r.URL.Host != "slides.googleapis.com" || r.URL.Path != "/v1/presentations/pres1" {
+			t.Fatalf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		if r.Header.Get("Authorization") != "" {
+			t.Fatal("unexpected authorization header")
+		}
+		if _, ok := r.Context().Deadline(); !ok {
+			t.Fatal("missing read deadline")
+		}
+		fields := r.URL.Query().Get("fields")
+		if calls == 0 {
+			if fields != string(slidesTextPresentationFields()) {
+				t.Fatalf("unexpected textual fields: %s", fields)
+			}
+			for _, forbidden := range []string{"image", "contentUrl", "thumbnail", "sheetsChart", "layout", "master", "link", "*"} {
+				if strings.Contains(fields, forbidden) {
+					t.Fatalf("unbounded field: %s", forbidden)
+				}
+			}
+		} else if fields != "presentationId,revisionId,slides(objectId)" {
+			t.Fatalf("unexpected final fields: %s", fields)
+		}
+		if calls >= len(bodies) {
+			t.Fatal("too many requests")
+		}
+		body := bodies[calls]
+		calls++
+		return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	})}
+	svc, err := slides.NewService(context.Background(), option.WithoutAuthentication(), option.WithHTTPClient(client))
+	if err != nil {
+		t.Fatal(err)
+	}
+	orig := newSlidesService
+	newSlidesService = func(_ context.Context, account string) (*slides.Service, error) {
+		factories++
+		if account != "synthetic@example.test" {
+			t.Fatalf("unexpected account: %s", account)
+		}
+		return svc, nil
+	}
+	t.Cleanup(func() {
+		newSlidesService = orig
+		if factories != 1 {
+			t.Errorf("service factory called %d times", factories)
+		}
+	})
+	return &calls
+}
+
+func slidesTextRun(t *testing.T, limit int) (string, error) {
+	t.Helper()
+	var runErr error
+	out := captureStdout(t, func() {
+		ctx := outfmt.WithMode(context.Background(), outfmt.Mode{JSON: true})
+		cmd := SlidesReadPresentationTextCmd{PresentationID: "pres1", MaxBytes: limit}
+		runErr = cmd.Run(ctx, &RootFlags{Account: "synthetic@example.test"})
+	})
+	return out, runErr
+}
