+const slidesTextFinal = `{"presentationId":"pres1","revisionId":"rev_1","slides":[{"objectId":"slide:1"},{"objectId":"slide_2"}]}`
+
+func TestSlidesReadPresentationTextRecursiveAndNotes(t *testing.T) {
+	calls := slidesTextMock(t, []string{slidesTextFixture, slidesTextFinal}, http.StatusOK)
+	out, err := slidesTextRun(t, slidesTextMaxBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if *calls != 2 {
+		t.Fatalf("requests=%d", *calls)
+	}
+	if strings.Contains(out, "DO_NOT_EMIT") || strings.Contains(out, "private.invalid") {
+		t.Fatal("asset metadata leaked")
+	}
+	var doc slidesTextDocument
+	if err := json.Unmarshal([]byte(out), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if doc.SchemaVersion != 1 || doc.PresentationID != "pres1" || doc.RevisionID != "rev_1" || doc.SlideCount != 2 || !doc.RevisionAndOrderRechecked || !doc.SlideOrderRechecked || !doc.PartialText || len(doc.Limitations) != 6 {
+		t.Fatalf("bad document metadata: %+v", doc)
+	}
+	first := doc.Slides[0]
+	if first.ObjectID != "slide:1" || first.Number != 1 || doc.Slides[1].Number != 2 {
+		t.Fatal("slide order lost")
+	}
+	if len(first.Elements) != 6 || len(first.Notes) != 4 {
+		t.Fatalf("elements=%d notes=%d", len(first.Elements), len(first.Notes))
+	}
+	if first.Elements[0].Text != "첫 줄\n2" || first.Elements[1].Text != "Grouped 한글" || strings.Join(first.Elements[1].GroupPath, "/") != "group_1/group_2" {
+		t.Fatal("shape text or group path lost")
+	}
+	for i, want := range []struct {
+		row, cell int
+		text      string
+	}{{0, 0, "Cell A\n"}, {0, 1, ""}, {1, 0, "Cell B"}} {
+		cell := first.Elements[i+2]
+		if cell.Kind != "table_cell" || cell.RowIndex == nil || *cell.RowIndex != want.row || cell.CellIndex == nil || *cell.CellIndex != want.cell || cell.Text != want.text {
+			t.Fatalf("bad cell: %+v", cell)
+		}
+	}
+	if first.Elements[5].Kind != "word_art" || first.Elements[5].Text != "장식 제목" || strings.Join(first.Elements[5].GroupPath, "/") != "group_1/group_2" {
+		t.Fatal("grouped WordArt text lost")
+	}
+	if first.Notes[1].PlaceholderType != "SLIDE_NUMBER" || first.Notes[1].Text != "1" || first.Notes[2].GroupPath[0] != "note_group" {
+		t.Fatal("non-BODY notes lost")
+	}
+	if first.Notes[3].Kind != "table_cell" || first.Notes[3].Text != "Note cell" {
+		t.Fatal("notes table lost")
+	}
+	if doc.Slides[1].Elements == nil || doc.Slides[1].Notes == nil {
+		t.Fatal("empty arrays must not be null")
+	}
+	count := len(doc.Title)
+	for _, page := range doc.Slides {
+		for _, records := range [][]slidesTextRecord{page.Elements, page.Notes} {
+			for _, record := range records {
+				count += len(record.Text)
+			}
+		}
+	}
+	if doc.TextBytes != count {
+		t.Fatalf("UTF-8 bytes got %d want %d", doc.TextBytes, count)
+	}
+}
